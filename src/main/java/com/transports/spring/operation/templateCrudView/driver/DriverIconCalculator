package com.transports.spring.operation.templateCrudView.driver;

import java.util.Map;

import com.transports.spring.model.InvolvedTransportNotification;
import com.transports.spring.model.Transport;
import com.transports.spring.operation.templateCrudView.driver.notification.DriverNotificationIconCalculator;
import com.transports.spring.vo.notification.VoNotificationIconDisplay;
import com.transports.spring.vo.driver.notification.VoGeneralDriverIcon;

public class DriverIconCalculator {

    /**
     * Calculates the general icons for a driver based on their notifications and transports.
     * @return
     */
    public VoGeneralDriverIcon calculateGeneralDriverIcons(final Map<Integer, InvolvedTransportNotification> driverNotificationMap, Map<Integer, Transport> driverTransportMap) {
        VoGeneralDriverIcon generalDriverIcon;
        
        final DriverNotificationIconCalculator driverNotificationIconCalculator = new DriverNotificationIconCalculator();
        final VoNotificationIconDisplay VoNotificationIconDisplay = driverNotificationIconCalculator.calculateGeneralDriverIcon(driverNotificationMap, driverTransportMap);

        if (VoNotificationIconDisplay.isShowIcon()) {
            generalDriverIcon = new VoGeneralDriverIcon(true, VoNotificationIconDisplay);
        } else {
            generalDriverIcon = new VoGeneralDriverIcon(false, null);
        }

        return generalDriverIcon;
    }

}